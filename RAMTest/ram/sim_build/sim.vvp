#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fdd12f5d9e0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5fdd12f36d90 .scope module, "ram" "ram" 3 6;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk_write";
    .port_info 1 /INPUT 5 "address_write";
    .port_info 2 /INPUT 16 "data_write";
    .port_info 3 /INPUT 1 "write_enable";
    .port_info 4 /INPUT 1 "clk_read";
    .port_info 5 /INPUT 5 "address_read";
    .port_info 6 /OUTPUT 16 "data_read";
P_0x5fdd12f5cff0 .param/l "A_WIDTH" 0 3 12, +C4<00000000000000000000000000000101>;
P_0x5fdd12f5d030 .param/l "D_WIDTH" 0 3 11, +C4<00000000000000000000000000010000>;
o0x7ef0c9071018 .functor BUFZ 5, C4<zzzzz>; HiZ drive
v0x5fdd12f734d0_0 .net "address_read", 4 0, o0x7ef0c9071018;  0 drivers
o0x7ef0c9071048 .functor BUFZ 5, C4<zzzzz>; HiZ drive
v0x5fdd12f83680_0 .net "address_write", 4 0, o0x7ef0c9071048;  0 drivers
o0x7ef0c9071078 .functor BUFZ 1, C4<z>; HiZ drive
v0x5fdd12f83760_0 .net "clk_read", 0 0, o0x7ef0c9071078;  0 drivers
o0x7ef0c90710a8 .functor BUFZ 1, C4<z>; HiZ drive
v0x5fdd12f83830_0 .net "clk_write", 0 0, o0x7ef0c90710a8;  0 drivers
v0x5fdd12f838f0_0 .var "data_read", 15 0;
o0x7ef0c9071108 .functor BUFZ 16, C4<zzzzzzzzzzzzzzzz>; HiZ drive
v0x5fdd12f83a20_0 .net "data_write", 15 0, o0x7ef0c9071108;  0 drivers
v0x5fdd12f83b00 .array "memory", 31 0, 15 0;
o0x7ef0c9071138 .functor BUFZ 1, C4<z>; HiZ drive
v0x5fdd12f83bc0_0 .net "write_enable", 0 0, o0x7ef0c9071138;  0 drivers
E_0x5fdd12f70a40 .event posedge, v0x5fdd12f83760_0;
E_0x5fdd12f37660 .event posedge, v0x5fdd12f83830_0;
S_0x5fdd12f36ff0 .scope module, "cocotb_iverilog_dump" "cocotb_iverilog_dump" 4 1;
 .timescale -9 -12;
    .scope S_0x5fdd12f36d90;
T_0 ;
    %wait E_0x5fdd12f37660;
    %load/vec4 v0x5fdd12f83bc0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x5fdd12f83a20_0;
    %load/vec4 v0x5fdd12f83680_0;
    %pad/u 7;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x5fdd12f83b00, 0, 4;
T_0.0 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5fdd12f36d90;
T_1 ;
    %wait E_0x5fdd12f70a40;
    %load/vec4 v0x5fdd12f734d0_0;
    %pad/u 7;
    %ix/vec4 4;
    %load/vec4a v0x5fdd12f83b00, 4;
    %assign/vec4 v0x5fdd12f838f0_0, 0;
    %jmp T_1;
    .thread T_1;
    .scope S_0x5fdd12f36d90;
T_2 ;
    %vpi_call/w 3 42 "$dumpfile", "waveform.vcd" {0 0 0};
    %vpi_call/w 3 43 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fdd12f36d90 {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x5fdd12f36ff0;
T_3 ;
    %vpi_call/w 4 3 "$dumpfile", "sim_build/ram.fst" {0 0 0};
    %vpi_call/w 4 4 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fdd12f36d90 {0 0 0};
    %end;
    .thread T_3;
