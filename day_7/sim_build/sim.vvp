#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x618f378b0190 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x618f3788ad90 .scope module, "not_gate" "not_gate" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /OUTPUT 1 "Y";
o0x70ba93430018 .functor BUFZ 1, C4<z>; HiZ drive
L_0x618f378d33c0 .functor NOT 1, o0x70ba93430018, C4<0>, C4<0>, C4<0>;
v0x618f3789cbf0_0 .net "A", 0 0, o0x70ba93430018;  0 drivers
v0x618f378d32a0_0 .net "Y", 0 0, L_0x618f378d33c0;  1 drivers
S_0x618f3788af20 .scope module, "cocotb_iverilog_dump" "cocotb_iverilog_dump" 4 1;
 .timescale -9 -12;
    .scope S_0x618f3788ad90;
T_0 ;
    %vpi_call/w 3 8 "$dumpfile", "not_gate.vcd" {0 0 0};
    %vpi_call/w 3 9 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x618f3788ad90 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x618f3788af20;
T_1 ;
    %vpi_call/w 4 3 "$dumpfile", "sim_build/not_gate.fst" {0 0 0};
    %vpi_call/w 4 4 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x618f3788ad90 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "verilog/not_gate.v";
    "sim_build/cocotb_iverilog_dump.v";
