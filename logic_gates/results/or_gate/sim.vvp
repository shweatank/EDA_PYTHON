#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x64e243872510 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x64e2438726a0 .scope module, "or_gate" "or_gate" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /OUTPUT 1 "Y";
o0x7d016db72018 .functor BUFZ 1, C4<z>; HiZ drive
o0x7d016db72048 .functor BUFZ 1, C4<z>; HiZ drive
L_0x64e2438bb450 .functor OR 1, o0x7d016db72018, o0x7d016db72048, C4<0>, C4<0>;
v0x64e2438abf10_0 .net "A", 0 0, o0x7d016db72018;  0 drivers
v0x64e2438bb270_0 .net "B", 0 0, o0x7d016db72048;  0 drivers
v0x64e2438bb330_0 .net "Y", 0 0, L_0x64e2438bb450;  1 drivers
S_0x64e2438abd80 .scope module, "cocotb_iverilog_dump" "cocotb_iverilog_dump" 4 1;
 .timescale -9 -12;
    .scope S_0x64e2438726a0;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "or_gate.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x64e2438726a0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x64e2438abd80;
T_1 ;
    %vpi_call/w 4 3 "$dumpfile", "results/or_gate/or_gate.fst" {0 0 0};
    %vpi_call/w 4 4 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x64e2438726a0 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "verilog/or_gate.v";
    "results/or_gate/cocotb_iverilog_dump.v";
