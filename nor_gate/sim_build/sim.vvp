:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5df1e0e51140 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5df1e0e512d0 .scope module, "nor_gate" "nor_gate" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
o0x7927fa439048 .functor BUFZ 1, C4<z>; HiZ drive
o0x7927fa439078 .functor BUFZ 1, C4<z>; HiZ drive
L_0x5df1e0e60310 .functor OR 1, o0x7927fa439048, o0x7927fa439078, C4<0>, C4<0>;
L_0x5df1e0e60410 .functor NOT 1, L_0x5df1e0e60310, C4<0>, C4<0>, C4<0>;
v0x5df1e0e3e450_0 .net *"_ivl_0", 0 0, L_0x5df1e0e60310;  1 drivers
v0x5df1e0e60070_0 .net "a", 0 0, o0x7927fa439048;  0 drivers
v0x5df1e0e60130_0 .net "b", 0 0, o0x7927fa439078;  0 drivers
v0x5df1e0e601d0_0 .net "y", 0 0, L_0x5df1e0e60410;  1 drivers
S_0x5df1e0e3e2c0 .scope module, "cocotb_iverilog_dump" "cocotb_iverilog_dump" 4 1;
 .timescale -9 -12;
    .scope S_0x5df1e0e3e2c0;
T_0 ;
    %vpi_call/w 4 3 "$dumpfile", "sim_build/nor_gate.fst" {0 0 0};
    %vpi_call/w 4 4 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5df1e0e512d0 {0 0 0};
    %end;
    .thread T_0;
