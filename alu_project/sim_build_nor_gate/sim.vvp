#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x6124acec9700 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x6124acea3d90 .scope module, "nor_gate" "nor_gate" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /OUTPUT 1 "Y";
o0x74e5027cf018 .functor BUFZ 1, C4<z>; HiZ drive
o0x74e5027cf048 .functor BUFZ 1, C4<z>; HiZ drive
L_0x6124aceed120 .functor OR 1, o0x74e5027cf018, o0x74e5027cf048, C4<0>, C4<0>;
L_0x6124aceed1f0 .functor NOT 1, L_0x6124aceed120, C4<0>, C4<0>, C4<0>;
v0x6124acea4100_0 .net "A", 0 0, o0x74e5027cf018;  0 drivers
v0x6124aceece60_0 .net "B", 0 0, o0x74e5027cf048;  0 drivers
v0x6124aceecf20_0 .net "Y", 0 0, L_0x6124aceed1f0;  1 drivers
v0x6124aceecfc0_0 .net *"_ivl_0", 0 0, L_0x6124aceed120;  1 drivers
S_0x6124acea3f70 .scope module, "cocotb_iverilog_dump" "cocotb_iverilog_dump" 4 1;
 .timescale -9 -12;
    .scope S_0x6124acea3d90;
T_0 ;
    %vpi_call/w 3 8 "$dumpfile", "nor_gate.vcd" {0 0 0};
    %vpi_call/w 3 9 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6124acea3d90 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x6124acea3f70;
T_1 ;
    %vpi_call/w 4 3 "$dumpfile", "sim_build_nor_gate/nor_gate.fst" {0 0 0};
    %vpi_call/w 4 4 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6124acea3d90 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "verilog/nor_gate.v";
    "sim_build_nor_gate/cocotb_iverilog_dump.v";
