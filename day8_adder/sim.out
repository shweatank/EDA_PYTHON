:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5e6f19faddc0 .scope module, "tb_adder" "tb_adder" 2 2;
 .timescale -9 -12;
v0x5e6f19ff9a90_0 .var "a", 3 0;
v0x5e6f19ff9b50_0 .var "b", 3 0;
v0x5e6f19ff9c20_0 .net "sum", 4 0, L_0x5e6f19ff9fd0;  1 drivers
S_0x5e6f19fadf50 .scope module, "uut" "adder" 2 7, 3 1 0, S_0x5e6f19faddc0;
 .timescale -9 -12;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /INPUT 4 "b";
    .port_info 2 /OUTPUT 5 "sum";
v0x5e6f19fe8790_0 .net *"_ivl_0", 4 0, L_0x5e6f19ff9d20;  1 drivers
L_0x7ef241c31018 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x5e6f19ff94a0_0 .net *"_ivl_3", 0 0, L_0x7ef241c31018;  1 drivers
v0x5e6f19ff9580_0 .net *"_ivl_4", 4 0, L_0x5e6f19ff9e90;  1 drivers
L_0x7ef241c31060 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x5e6f19ff9640_0 .net *"_ivl_7", 0 0, L_0x7ef241c31060;  1 drivers
v0x5e6f19ff9720_0 .net "a", 3 0, v0x5e6f19ff9a90_0;  1 drivers
v0x5e6f19ff9850_0 .net "b", 3 0, v0x5e6f19ff9b50_0;  1 drivers
v0x5e6f19ff9930_0 .net "sum", 4 0, L_0x5e6f19ff9fd0;  alias, 1 drivers
L_0x5e6f19ff9d20 .concat [ 4 1 0 0], v0x5e6f19ff9a90_0, L_0x7ef241c31018;
L_0x5e6f19ff9e90 .concat [ 4 1 0 0], v0x5e6f19ff9b50_0, L_0x7ef241c31060;
L_0x5e6f19ff9fd0 .arith/sum 5, L_0x5e6f19ff9d20, L_0x5e6f19ff9e90;
    .scope S_0x5e6f19faddc0;
T_0 ;
    %vpi_call 2 14 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call 2 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5e6f19faddc0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5e6f19ff9a90_0, 0, 4;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5e6f19ff9b50_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5e6f19ff9a90_0, 0, 4;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x5e6f19ff9b50_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x5e6f19ff9a90_0, 0, 4;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5e6f19ff9b50_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5e6f19ff9a90_0, 0, 4;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5e6f19ff9b50_0, 0, 4;
    %delay 10000, 0;
    %vpi_call 2 21 "$finish" {0 0 0};
    %end;
    .thread T_0;
